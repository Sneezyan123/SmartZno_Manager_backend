# SmartManager — CRM API
APP_NAME=SmartManager
APP_ENV=development
TZ=Europe/Kyiv

MONGODB_CRM_URI=mongodb://localhost:27017
MONGODB_CRM_DB=smartzno_crm

JWT_SECRET=change-me-in-production
JWT_TTL_MIN=480

CRM_API_KEY=dev-crm-api-key
LMS_API_KEY=dev-lms-api-key
LEAD_INGEST_HMAC_SECRET=dev-lead-hmac

# Land + Manager origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Telegram — сповіщення менеджерам про заявки / діагностики
# 1) створіть бота через @BotFather → TELEGRAM_BOT_TOKEN
# 2) напишіть боту /start, дізнайтесь chat_id (@userinfobot або getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Placeholders
# GOOGLE_SA_JSON=
