  "theory": [
    {
      "type": "heading",
      "content": "Означення"
    },
    {
      "type": "formula",
      "content": "log_a b = c  ⇔  a^c = b  (a>0, a≠1, b>0)"
    },
    {
      "type": "list",
      "content": "Властивості:",
      "items": [
        "log_a(bc) = log_a b + log_a c",
        "log_a(b/c) = log_a b − log_a c",
        "log_a(b^k) = k · log_a b",
        "log_a a = 1;  log_a 1 = 0;  a^(log_a b) = b"
      ]
    },
    {
      "type": "example",
      "content": "log_2 8 = 3, бо 2^3 = 8"
    },
    {
      "type": "tip",
      "content": "Формули логарифмів є в довідці НМТ."
    }
