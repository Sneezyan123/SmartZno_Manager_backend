  "theory": [
    {
      "type": "heading",
      "content": "Базові перетворення y=f(x)"
    },
    {
      "type": "list",
      "content": "Правила:",
      "items": [
        "f(x)+a — вгору на a (вниз, якщо a<0)",
        "f(x−a) — праворуч на a",
        "−f(x) — симетрія відносно Ox",
        "f(−x) — симетрія відносно Oy",
        "k f(x), k>1 — розтяг від Ox",
        "f(kx), k>1 — стиск до Oy"
      ]
    },
    {
      "type": "example",
      "content": "y=(x−2)²+3 — парабола y=x² праворуч на 2 і вгору на 3, вершина (2;3)."
    },
    {
      "type": "tip",
      "content": "Знак усередині: x−a рухає в бік +a (праворуч)."
    }
  ],
