  "theory": [
    {
      "type": "heading",
      "content": "Показникова y=a^x (a>0, a≠1)"
    },
    {
      "type": "list",
      "content": "Властивості:",
      "items": [
        "Область — усі дійсні, значення — (0; ∞)",
        "Завжди проходить через (0; 1)",
        "a>1 — зростає; 0<a<1 — спадає",
        "Горизонтальна асимптота y=0"
      ]
    },
    {
      "type": "heading",
      "content": "Логарифмічна y=log_a x"
    },
    {
      "type": "list",
      "content": "Властивості:",
      "items": [
        "Область x>0, проходить через (1; 0)",
        "a>1 — зростає; 0<a<1 — спадає",
        "Вертикальна асимптота x=0",
        "Обернена до показникової з тією ж основою"
      ]
    },
    {
      "type": "example",
      "content": "y=2^x: 2^0=1, 2^3=8. y=log_2 x: log_2 8=3."
    }
  ],
