  "theory": [
    {
      "type": "heading",
      "content": "Формули (є в довідці)"
    },
    {
      "type": "formula",
      "content": "a_n = a_1 + d(n−1)"
    },
    {
      "type": "formula",
      "content": "S_n = (a_1 + a_n)/2 · n  =  (2a_1 + d(n−1))/2 · n"
    },
    {
      "type": "paragraph",
      "content": "d — різниця: a_{k+1} − a_k. Середній член: a_k = (a_{k−1}+a_{k+1})/2."
    },
    {
      "type": "example",
      "content": "2, 5, 8, 11: d=3, a_10=2+3·9=29."
    },
    {
      "type": "tip",
      "content": "Спочатку знайди d з двох сусідніх, потім n-й член."
    }
  ],
