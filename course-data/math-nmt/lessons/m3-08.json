  "theory": [
    {
      "type": "heading",
      "content": "Формули (є в довідці)"
    },
    {
      "type": "formula",
      "content": "b_n = b_1 · q^(n−1)"
    },
    {
      "type": "formula",
      "content": "S_n = b_1 (q^n − 1)/(q − 1),  q ≠ 1"
    },
    {
      "type": "paragraph",
      "content": "q — знаменник: b_{k+1}/b_k. Якщо q=1, усі члени рівні b1, S_n=n b1."
    },
    {
      "type": "example",
      "content": "3, 6, 12, 24: q=2, b_6=3·2^5=96."
    },
    {
      "type": "tip",
      "content": "Три числа a,b,c у ГП: b²=ac (при відповідних знаках)."
    }
  ],
